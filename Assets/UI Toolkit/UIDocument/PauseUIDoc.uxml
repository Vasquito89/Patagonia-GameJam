            <ui:Label text="Label" name="VidaFuegoLabel" style="position: absolute; font-size: 28px; top: 57px; left: 1px; width: 254px; color: rgb(255, 255, 255); background-color: rgb(87, 83, 83);"/>
            <ui:Label text="Apaga el Fuego!!" name="AdvertenciaLabel" style="position: absolute; font-size: 28px; top: 177px; left: 659px; width: 286px; height: 55px; background-color: rgb(87, 83, 83); color: rgb(255, 255, 255);"/>
            <ui:Label text="Label" name="PromptLabel" style="position: absolute; top: 173px; left: 39px; width: 456px; height: 49px; font-size: 28px; color: rgb(255, 255, 255); background-color: rgb(87, 83, 83); display: flex;"/>
            <ui:Image style="position: absolute; height: 17px; width: 18px; top: 319px; left: 500px; background-image: none; background-color: rgb(24, 26, 26); border-top-left-radius: 50px; border-top-right-radius: 50px; border-bottom-right-radius: 50px; border-bottom-left-radius: 50px;"/>
