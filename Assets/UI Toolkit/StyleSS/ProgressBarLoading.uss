.unity-progress-bar__progress {
    background-color: rgb(230, 185, 132);
    border-radius: 4px;
    margin: 0;
    transition-property: width;
    transition-duration: 0.1s;
    top: -2px;
    left: -2px;
    flex-direction: row;
    height: 30px;
    -unity-background-image-tint-color: rgba(250, 250, 250, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    display: flex;
    color: rgba(27, 27, 27, 0);
    background-image: url("project://database/Assets/StarterAssets/Mobile/UI/UI_Circle_Bevel_Base.png?fileID=2800000&guid=b74c31d447d2f5d41a61081bdf5e7126&type=3#UI_Circle_Bevel_Base");
}

.unity-progress-bar__background {
    background-color: rgba(44, 63, 69, 0);
    border-width: 0;
    margin: 0;
    padding: 0;
    height: 30px;
    flex-shrink: 0;
    flex-direction: column;
    display: flex;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    color: rgba(27, 27, 27, 0);
}

.unity-progress-bar__title-container {
    display: none;
    background-color: rgba(0, 0, 0, 0);
}
